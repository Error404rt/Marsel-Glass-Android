{
  "manifest_version": 3,
  "name": "Maarrsel",
  "version": "1.4.0",
  "description": "A customizable new tab with wallpaper, glass effects and quick links.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Maarrsel"
  }
}